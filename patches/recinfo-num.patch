+static int ParseKanjiNumber(const wstring& s)
+{
+	if( s.empty() ) return -1;
+	bool hasUnit = false;
+	for( wchar_t c : s ){
+		if( c == L'十' || c == L'百' || c == L'千' || c == L'拾' ){
+			hasUnit = true;
+			break;
+		}
+	}
+	if( hasUnit ){
+		int total = 0;
+		int current = 0;
+		for( wchar_t c : s ){
+			int digit = 0;
+			switch(c){
+				case L'〇': case L'零': digit = 0; break;
+				case L'一': case L'壱': digit = 1; break;
+				case L'二': case L'弐': digit = 2; break;
+				case L'三': case L'参': digit = 3; break;
+				case L'四': digit = 4; break;
+				case L'五': digit = 5; break;
+				case L'六': digit = 6; break;
+				case L'七': digit = 7; break;
+				case L'八': digit = 8; break;
+				case L'九': digit = 9; break;
+				case L'十': case L'拾':
+					total += (current == 0 ? 1 : current) * 10;
+					current = 0;
+					continue;
+				case L'百':
+					total += (current == 0 ? 1 : current) * 100;
+					current = 0;
+					continue;
+				case L'千':
+					total += (current == 0 ? 1 : current) * 1000;
+					current = 0;
+					continue;
+				default:
+					return -1;
+			}
+			current = digit;
+		}
+		total += current;
+		return total;
+	}else{
+		int total = 0;
+		for( wchar_t c : s ){
+			int digit = 0;
+			switch(c){
+				case L'〇': case L'零': digit = 0; break;
+				case L'一': case L'壱': digit = 1; break;
+				case L'二': case L'弐': digit = 2; break;
+				case L'三': case L'参': digit = 3; break;
+				case L'四': digit = 4; break;
+				case L'五': digit = 5; break;
+				case L'六': digit = 6; break;
+				case L'七': digit = 7; break;
+				case L'八': digit = 8; break;
+				case L'九': digit = 9; break;
+				default: return -1;
+			}
+			total = total * 10 + digit;
+		}
+		return total;
+	}
+}
