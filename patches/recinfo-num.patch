+static void NormalizeEventNameForRecCheck(wstring& str)
+{
+	// 1. 全角英数・記号の半角化および小文字化
+	for( auto& c : str ){
+		if( L'０' <= c && c <= L'９' ){
+			c = c - L'０' + L'0';
+		}else if( L'Ａ' <= c && c <= L'Ｚ' ){
+			c = c - L'Ａ' + L'a';
+		}else if( L'ａ' <= c && c <= L'ｚ' ){
+			c = c - L'ａ' + L'a';
+		}else if( c == L'　' ){
+			c = L' ';
+		}
+	}
+
+	// 2. 丸数字 (①〜⑳, ❶〜❿) の半角数字化
+	static const struct { wchar_t from; int num; } circleNumTable[] = {
+		{ L'①', 1 }, { L'②', 2 }, { L'③', 3 }, { L'④', 4 }, { L'⑤', 5 },
+		{ L'⑥', 6 }, { L'⑦', 7 }, { L'⑧', 8 }, { L'⑨', 9 }, { L'⑩', 10 },
+		{ L'⑪', 11 }, { L'⑫', 12 }, { L'⑬', 13 }, { L'⑭', 14 }, { L'⑮', 15 },
+		{ L'⑯', 16 }, { L'⑰', 17 }, { L'⑱', 18 }, { L'⑲', 19 }, { L'⑳', 20 },
+		{ L'❶', 1 }, { L'❷', 2 }, { L'❸', 3 }, { L'❹', 4 }, { L'❺', 5 },
+		{ L'❻', 6 }, { L'❼', 7 }, { L'❽', 8 }, { L'❾', 9 }, { L'❿', 10 },
+	};
+	for( size_t i = 0; i < str.size(); i++ ){
+		for( const auto& item : circleNumTable ){
+			if( str[i] == item.from ){
+				WCHAR numBuf[32];
+				swprintf_s(numBuf, L" %d ", item.num);
+				str.replace(i, 1, numBuf);
+				i += wcslen(numBuf) - 1;
+				break;
+			}
+		}
+	}
+
+	// 3. 汎用「第 + (数字|漢数字) + 任意の助数詞」および漢数字話数の正規化
+	try{
+		// 3-a. 「第」で始まるパターン: 第\s*([0-9]+|[一二三四五六七八九十百千〇零壱弐参拾]+) + 任意の助数詞
+		std::wregex reDai(L"第\\s*([0-9]+|[一二三四五六七八九十百千〇零壱弐参拾]+)(?:\\s*[^\\s0-9a-zA-Z\\[\\]\\(\\)\\（\\）\\「\\」\\『\\』\\【\\】\\〔\\〕\\〈\\〉\\《\\》▽▼★☆◆◇●○■□・:;／/\\\\~〜～]*)?");
+		std::wsmatch m;
+		wstring result;
+		auto it = str.cbegin();
+		while( std::regex_search(it, str.cend(), m, reDai) ){
+			result.append(it, it + m.position(0));
+			wstring numStr = m[1].str();
+			int num = -1;
+			if( iswdigit(numStr[0]) ){
+				num = (int)wcstol(numStr.c_str(), NULL, 10);
+			}else{
+				num = ParseKanjiNumber(numStr);
+			}
+			if( num >= 0 ){
+				WCHAR numBuf[32];
+				swprintf_s(numBuf, L" %d ", num);
+				result += numBuf;
+			}else{
+				result += m[0].str();
+			}
+			it += m.position(0) + m.length(0);
+		}
+		result.append(it, str.cend());
+		str.swap(result);
+
+		// 3-b. 助数詞が直後に付く漢数字単体
+		std::wregex reKanjiUnit(L"([一二三四五六七八九十百千〇零壱弐参拾]+)\\s*([話回夜節巻部章幕弾局戦篇])");
+		it = str.cbegin();
+		result.clear();
+		while( std::regex_search(it, str.cend(), m, reKanjiUnit) ){
+			result.append(it, it + m.position(0));
+			int num = ParseKanjiNumber(m[1].str());
+			if( num >= 0 ){
+				WCHAR numBuf[32];
+				swprintf_s(numBuf, L" %d ", num);
+				result += numBuf;
+			}else{
+				result += m[0].str();
+			}
+			it += m.position(0) + m.length(0);
+		}
+		result.append(it, str.cend());
+		str.swap(result);
+
+		// 3-c. [#＃♯]\s*(\d+) -> " $1 "
+		str = std::regex_replace(str, std::wregex(L"[#＃♯]\\s*([0-9]+)"), L" $1 ");
+
+		// 3-d. 括弧囲み数字
+		std::wregex reBracket(L"[\\(\\[（［【〔〈《]\\s*([0-9]+|[一二三四五六七八九十百千〇零壱弐参拾]+)\\s*[\\)\\]）］】〕〉》]");
+		it = str.cbegin();
+		result.clear();
+		while( std::regex_search(it, str.cend(), m, reBracket) ){
+			result.append(it, it + m.position(0));
+			wstring numStr = m[1].str();
+			int num = -1;
+			if( iswdigit(numStr[0]) ){
+				num = (int)wcstol(numStr.c_str(), NULL, 10);
+			}else{
+				num = ParseKanjiNumber(numStr);
+			}
+			if( num >= 0 ){
+				WCHAR numBuf[32];
+				swprintf_s(numBuf, L" %d ", num);
+				result += numBuf;
+			}else{
+				result += m[0].str();
+			}
+			it += m.position(0) + m.length(0);
+		}
+		result.append(it, str.cend());
+		str.swap(result);
+
+	}catch( std::exception& ){}
+
+	// 4. 区切り記号・装飾記号を半角スペースに統一
+	static const wchar_t symbols[] = L"▽▼★☆◆◇●○■□▲△・:;／/\\_＿~〜～「」『』";
+	for( size_t i = 0; i < str.size(); i++ ){
+		for( size_t j = 0; symbols[j] != L'\0'; j++ ){
+			if( str[i] == symbols[j] ){
+				str[i] = L' ';
+				break;
+			}
+		}
+	}
+
+	// 5. 連続スペースの集約および前後のトリム
+	wstring cleaned;
+	cleaned.reserve(str.size());
+	bool inSpace = true;
+	for( wchar_t c : str ){
+		if( c == L' ' || c == L'\t' ){
+			if( !inSpace ){
+				cleaned.push_back(L' ');
+				inSpace = true;
+			}
+		}else{
+			cleaned.push_back(c);
+			inSpace = false;
+		}
+	}
+	while( !cleaned.empty() && cleaned.back() == L' ' ){
+		cleaned.pop_back();
+	}
+	str.swap(cleaned);
+}
